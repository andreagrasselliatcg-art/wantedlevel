<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Wanted Level @VERSION@ - Tune Talks</title>
    <organization>com.tunetalks</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3" description="Plug-in VST3 per Ableton Live, Cubase, FL Studio, Reaper, Studio One e altre DAW.">
        <pkg-ref id="com.tunetalks.wantedlevel.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="Plug-in Audio Unit per Logic Pro, GarageBand e Ableton Live.">
        <pkg-ref id="com.tunetalks.wantedlevel.au"/>
    </choice>
    <choice id="app" title="App Standalone" description="Versione autonoma da usare senza DAW." start_selected="false">
        <pkg-ref id="com.tunetalks.wantedlevel.standalone"/>
    </choice>

    <pkg-ref id="com.tunetalks.wantedlevel.vst3"       version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.tunetalks.wantedlevel.au"         version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.tunetalks.wantedlevel.standalone" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
